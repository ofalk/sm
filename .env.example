# ServerManager (sm) environment configuration.
#
# Copy this file to `.env` (which is git-ignored) and fill in the values.
# Every key below is read via python-decouple; see sm/sm/settings.py for the
# full list of options and defaults.

# --- Core ------------------------------------------------------------------
# Enable Django debug mode. Never enable this in production.
DEBUG=False

# REQUIRED when DEBUG=False (the app refuses to start without it).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated list of host/domain names the app is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Leave unset to use the default local SQLite file. Set a connection URL to use
# PostgreSQL/MySQL/etc, e.g. postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=

# --- Email -----------------------------------------------------------------
# Default logs mail to the console. For production use the SMTP backend and
# set EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
THEME_CONTACT_EMAIL=
THEME_GITHUB_URL=

# --- Admin bootstrap (consumed by entrypoint.sh ensure_admin) --------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# If unset, entrypoint.sh generates a random password and writes it to
# /app/.admin_password instead of printing it.
ADMIN_PASSWORD=

# --- Features --------------------------------------------------------------
# Set to True to disable social (Google/OIDC) login entirely.
DISABLE_SOCIAL_AUTH=False
# Swetrix analytics (disabled by default).
ANALYTICS_ENABLED=False
ANALYTICS_ID=
ANALYTICS_BASE_URL=https://api.swetrix.com

# --- Social auth / OAuth ---------------------------------------------------
# Google
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
# Generic OpenID Connect
OIDC_CLIENT_ID=
OIDC_SECRET=
OIDC_URL=
OIDC_NAME=Localghost SSO

# --- HTTPS / security hardening (only applied when DEBUG=False) ------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
